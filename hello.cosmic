publish("=== CosmicLang v2.0 feature reference ===")

publish("--- 1. numbers & precedence: * and / bind tighter than + - ---")
a = 2 + 3 * 4
publish(a)

b = (2 + 3) * 4
publish(b)

publish("--- 2. negative numbers & nested parens ---")
c = -5
publish(c)

d = -(3 + 2)
publish(d)

e = --5
publish(e)

publish("--- 3. variables: assign, reassign, reuse ---")
x = 10
x = x + 5
publish(x)

publish("--- 4. strings & concatenation with + ---")
first = "Cosmic"
second = "Lang"
full = first + second
publish(full)

publish("--- 5. comparison operators: > < >= <= == != ---")
publish(10 > 5)
publish(10 < 5)
publish(10 >= 10)
publish(10 <= 9)
publish(10 == 10)
publish(10 != 10)

publish("--- 6. ternary conditionals: cond ? { } : { } ---")
x2 = 10
y2 = 20

result = x2 > y2 ? {
    publish("x2 is bigger")
} : {
    publish("y2 is bigger")
}

p = 100
q = 200
result2 = p < q ? {
    diff = q - p
    publish(diff)
} : {
    publish("p is bigger")
}

publish("--- 7. publish() prints any expression ---")
publish("this prints to stdout")
publish(1 + 1)

publish("--- 8. whole file compiles as one multi-line program ---")
publish("done")

